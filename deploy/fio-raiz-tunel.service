[Unit]
Description=Tunel reverso do Fio Raiz para o Mac (127.0.0.1:2794 -> 2793)
After=network-online.target fio-raiz.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ConnectTimeout=10 -o ExitOnForwardFailure=yes -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -R 2794:127.0.0.1:2793 mac
Restart=always
RestartSec=15
SyslogIdentifier=fio-raiz-tunel

[Install]
WantedBy=default.target
